{
  "expo": {
    "newArchEnabled": true,
    "name": "SpellSmart",
    "slug": "SpellSmart",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you create your own word lists."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Recursive-Bold.ttf",
            "./assets/fonts/Inter-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a1a",
          "image": "./assets/images/android.jpg",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "version": "14.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/android.jpg",
    "splash": {
      "image": "./assets/images/android.jpg",
      "backgroundColor": "#1a1a1a"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/d453fba4-d8ab-4df0-aa8c-7f5e6507b18a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.awesomeaariv.SpellSmart",
      "buildNumber": "24",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-1024.jpg",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.SpellSmart",
      "versionCode": 24,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/android-48.jpg"
    },
    "extra": {
      "eas": {
        "projectId": "d453fba4-d8ab-4df0-aa8c-7f5e6507b18a"
      },
      "listsBaseUrl": "https://pub-85787839b47240eaa2120d34de5874ca.r2.dev/lists",
      "audioBaseUrl": "https://pub-85787839b47240eaa2120d34de5874ca.r2.dev/audio",
      "ttsProxyUrl": "https://spellsmart-tts.awesomeaariv.workers.dev"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
