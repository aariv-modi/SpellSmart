# Path to your GCP service account JSON (used by scripts/generate-audio.mjs)
# This service account needs the "Cloud Text-to-Speech User" role.
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json

# Google Cloud TTS voice settings (optional; defaults shown)
# Available voices: https://cloud.google.com/text-to-speech/docs/voices
TTS_VOICE_NAME=en-US-Neural2-D
TTS_LANGUAGE_CODE=en-US
TTS_CONCURRENCY=10

# Cloudflare R2 (used by scripts/publish-content.mjs)
# Account ID: dashboard URL is https://dash.cloudflare.com/<ACCOUNT_ID>/...
R2_ACCOUNT_ID=
# Create at: Cloudflare dashboard -> R2 -> Manage R2 API Tokens
# Permissions: Object Read & Write, scoped to the spellsmart-audio bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=spellsmart-audio
R2_CONCURRENCY=10
